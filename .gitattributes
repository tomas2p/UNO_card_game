# Text: normalise to LF in the repository and on checkout
* text=auto eol=lf

# Scripts and build files need LF to run correctly
*.sh text eol=lf
makefile text eol=lf

# Vector assets are text
*.svg text eol=lf

# Binary assets: never diff, merge or convert line endings
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
